{
    "type": "mutation"
	"id": "mutation_growth",
    "name": "Growth Potential",
    "description": "You have an innate magical potential to grow to huge proportions. Activate to increase in size or return to normal.",
    "points": 2,
	"vitamin_cost": 160,
	"visibility": 0,
	"ugliness": 0,
	"active": true,
	"cost": 100,
	"mana": true,
	"activated_eocs": [ "EOC_GROWTH_MUTATION" ],
	"deactivated_eocs": [ "EOC_GROWTH_MUTATION_REMOVE" ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_GROWTH_MUTATION",
    "condition": {
      "and": [
        { "not": { "u_has_trait": "HUGE" } },
        { "not": { "u_has_trait": "HUGE_OK" } },
        { "not": { "u_has_trait": "BIO_GIANT_GROWTH" } },
		{ "not": { "u_has_trait": "MUT_GROWTH" } }
      ]
    },
    "effect": [
      { "u_message": "Your body shudders as your size increases!", "type": "good" },
      { "math": [ "u_preshift_size = u_val('size')" ] },
      {
        "switch": { "math": [ "u_preshift_size" ] },
        "cases": [
          { "case": 1, "effect": [ { "math": [ "u_calories('dont_affect_weariness': true) *= 12" ] } ] },
          { "case": 2, "effect": [ { "math": [ "u_calories('dont_affect_weariness': true) *= 6" ] } ] },
          { "case": 3, "effect": [ { "math": [ "u_calories('dont_affect_weariness': true) *= 2" ] } ] },
          { "case": 4, "effect": [ { "math": [ "u_calories('dont_affect_weariness': true) *= 1.5" ] } ] },
          { "case": 5, "effect": [  ] }
        ]
      },
      { "u_add_trait": "MUT_GROWTH" }
    ],
    "false_effect": [ { "u_message": "You are already huge--you cannot grow any larger!" } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_GROWTH_MUTATION_REMOVE",
    "condition": { "u_has_trait": "MUT_GROWTH" },
    "effect": [
      { "u_message": "Your body shudders as your size decreases!", "type": "bad" },
      {
        "switch": { "math": [ "u_preshift_size" ] },
        "cases": [
          { "case": 1, "effect": [ { "math": [ "u_calories('dont_affect_weariness': true) /= 12" ] } ] },
          { "case": 2, "effect": [ { "math": [ "u_calories('dont_affect_weariness': true) /= 6" ] } ] },
          { "case": 3, "effect": [ { "math": [ "u_calories('dont_affect_weariness': true) /= 2" ] } ] },
          { "case": 4, "effect": [ { "math": [ "u_calories('dont_affect_weariness': true) /= 1.5" ] } ] },
          { "case": 5, "effect": [  ] }
        ]
      },
      { "u_lose_trait": "MUT_GROWTH" }
    ]
  },
